---
import Base from '../layouts/Base.astro';
import '../widgets/atomic-clock.css';
import data from '../data/core-data.json';
---
<Base tool title="Atomic clock — UTC, TAI and GPS time to the millisecond — clocknow" description="Live UTC with milliseconds, plus TAI and GPS time, synced to a precise server clock with a visible accuracy state." path="/atomic">
  <h1>Atomic time</h1>
  <section class="hero"><atomic-clock tai={String(data.tai_minus_utc_s)} gps={String(data.gps_minus_utc_s)}></atomic-clock></section>
  <device-offset class="do-card"><p data-line>Checking your device clock…</p></device-offset>
  <section class="verify">
    <h2>Proof of time</h2>
    <p>Ask the server for a timestamp signed with Ed25519 and check the signature here in your browser. Then copy a signed receipt you can keep or send to someone else as proof.</p>
    <verify-time></verify-time>
    <p><a href="/about/signed-time">How signed time works and how to verify it yourself</a></p>
  </section>
  <script>
    import '../widgets/atomic-clock';
    import '../widgets/device-offset';
    import '../widgets/verify-time';
  </script>
</Base>
