---
import Base from '../layouts/Base.astro';
import data from '../data/core-data.json';
const featured = ['new-york', 'london', 'dubai', 'karachi', 'tokyo', 'sydney'];
const cities = featured.map((s) => data.cities.find((c) => c.slug === s)!);
---
<Base title="Exact time now — clocknow" description="The exact current time, synced to a precise server clock, with a live accuracy badge. World clock, atomic time and more." path="/">
  <h1>Your local time</h1>
  <section class="hero"><tz-clock></tz-clock></section>
  <ul class="world">
    {cities.map((c) => (
      <li><a href={`/time/${c.slug}`}><div class="city">{c.name}, {c.country}</div><tz-clock zone={c.zone} no-seconds></tz-clock></a></li>
    ))}
  </ul>
  <ul class="all-cities">
    {data.cities.map((c) => <li><a href={`/time/${c.slug}`}>Time in {c.name}</a></li>)}
  </ul>
  <script>
    import '../widgets/tz-clock';
  </script>
</Base>
