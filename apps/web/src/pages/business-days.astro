---
import Base from '../layouts/Base.astro';
import '../widgets/convert.css';
import { DATA } from '../lib/cities';
import { HOLIDAYS } from '../lib/holidays';

const countries = Object.keys(HOLIDAYS.countries)
  .map((cc) => [cc.toLowerCase(), (DATA.countries[cc] ?? cc).replace(/[|:]/g, ' ')] as const)
  .sort((a, b) => a[1].localeCompare(b[1]))
  .map(([cc, n]) => `${cc}:${n}`)
  .join('|');
---
<Base tool crumbs={[{ name: 'Converters', path: '/convert' }, { name: 'Business days calculator', path: '/business-days' }]} title="Business days calculator — clocknow" description="Count working days between two dates, or add working days to a date, with the weekend and public holidays of your country filled in." path="/business-days">
  <h1>Business days calculator</h1>
  <section class="hero"><cv-business countries={countries}></cv-business></section>
  <section class="cv-note"><h2>How it works</h2><p>Counting includes both the start and end dates, like the spreadsheet function NETWORKDAYS. Pick the weekend that applies where you work: Saturday and Sunday, Friday and Saturday, or another pattern. Choose a country to fill in its weekend and national <a href="/holidays">public holidays</a>, then add or remove dates for your employer or region. Holidays that fall on a weekend are ignored.</p><p>Adding working days moves forward, or backward with a negative number, skipping weekends and holidays.</p></section>
  <script>
    import '../widgets/cv-business';
  </script>
</Base>
