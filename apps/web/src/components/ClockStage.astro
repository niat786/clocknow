---
// The main clock "stage": place line, face picker, synced clock, date chips and display toggles.
// Without JavaScript enhancements it is still the plain synced clock.
import TzClock from './TzClock.astro';
import { FACES } from '../widgets/faces';
interface Props { zone?: string; place?: string }
const { zone, place } = Astro.props;
const TOGGLES = [['h12', '12h', '12-hour clock'], ['seconds', ':ss', 'Show seconds'], ['ms', '.ms', 'Show milliseconds'], ['sound', 'Tick', 'Ticking sound']];
---
<section class="hero stage">
  <div class="stage-top fs-hide">
    <p class="stage-place">
      <span class="stage-dot" aria-hidden="true"></span>
      <strong data-stage-place data-auto={place ? undefined : ''}>{place ?? 'Your time zone'}</strong>
      <a class="chip" href="/time">Change</a>
      <span class="stage-zone mono" data-stage-zone>{zone ?? ''}</span>
    </p>
    <face-switch><div class="fsw" role="radiogroup" aria-label="Clock style">{FACES.map((f, i) => <button type="button" role="radio" data-face={f.id} aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{f.label}</button>)}</div></face-switch>
  </div>
  <TzClock zone={zone} faces stage />
  <div class="stage-bottom fs-hide">
    <div class="stage-chips" data-stage-chips><span class="chip ph">Week 00</span><span class="chip ph">Day 000</span><span class="chip ph">00 Jumada al-awwal 0000 AH</span></div>
    <div class="stage-toggles" data-stage-toggles>{TOGGLES.map(([key, label, title]) => <button type="button" class="chip stage-toggle" data-key={key} title={title} aria-label={title} aria-pressed={key === 'seconds' ? 'true' : 'false'}>{label}</button>)}</div>
  </div>
</section>
