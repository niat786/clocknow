---
import '../styles/site.css';
import '../styles/crumbs.css';
import '../styles/menu.css';
import '../styles/look.css';
import '../styles/reserve.css';
import '../widgets/tz-clock.css';
import '../widgets/fullscreen.css';
import themeInit from '../theme-init.js?raw';
import { ABOUT, isCurrent, menu } from '../lib/menu';
import { SITE, breadcrumbLd, fitDescription, organizationLd, serializeLd, webAppLd, websiteLd, type Crumb, type Ld } from '../lib/jsonld';
interface Props { title: string; description: string; path: string; crumbs?: Crumb[]; tool?: boolean; schema?: Ld[] }
const { title, description: rawDescription, path, crumbs = [], tool = false, schema = [] } = Astro.props;
const description = fitDescription(rawDescription);
const canonical = new URL(path, SITE).href;
const image = `${SITE}/og.png`;
const groups = menu(new Date().getUTCFullYear());
const THEMES = [['auto', 'Auto', 'Auto'], ['light', 'Light', 'Light'], ['night', 'Night', 'Night'], ['oled', 'OLED', 'OLED'], ['contrast', 'High contrast', 'AAA']];
const graph: Ld[] = [
  websiteLd(),
  organizationLd(),
  ...(crumbs.length ? [breadcrumbLd(crumbs)] : []),
  ...(tool ? [webAppLd({ name: title.replace(/ \u2014 clocknow$/, ''), description, path })] : []),
  ...schema,
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="clocknow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="clocknow: the exact time" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script is:inline type="application/ld+json" set:html={serializeLd(graph)} />
    <script is:inline set:html={themeInit.trim()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="clocknow home"><svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="3.5" class="brand-dot" /></svg><span>clocknow</span></a>
      <nav class="menu" aria-label="Main">
        {groups.map((g) => (
          <details class="menu-g" data-active={g.items.some((i) => isCurrent(i.href, path)) ? '' : undefined}>
            <summary>{g.name}</summary>
            <ul>
              {g.items.map((i) => <li><a href={i.href} aria-current={isCurrent(i.href, path) ? 'page' : undefined}>{i.name}</a></li>)}
            </ul>
          </details>
        ))}
      </nav>
      <button type="button" class="hd-search" data-search aria-haspopup="dialog" aria-label="Search cities and tools">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span class="hd-search-text">Jump to city or tool…</span><kbd class="hd-kbd">⌘K</kbd>
      </button>
      <theme-switch>
        <div class="ts-group" role="radiogroup" aria-label="Theme">{THEMES.map(([v, label, short]) => <button type="button" value={v} role="radio" title={label} aria-label={short !== label ? label : undefined} aria-checked={v === 'auto' ? 'true' : 'false'} tabindex={v === 'auto' ? 0 : -1}>{short}</button>)}</div>
        <select class="ts-select" aria-label="Theme">{THEMES.map(([v, label]) => <option value={v}>{label}</option>)}</select>
      </theme-switch>
      <button type="button" class="fs-toggle" data-fs-toggle aria-pressed="false" aria-label="Fullscreen">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span class="fs-text">Fullscreen</span>
      </button>
    </header>
    <main>
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {crumbs.map((c, i) => (
              <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <p class="fs-hint">Tap anywhere for fullscreen</p>
    <footer class="site-footer">
      <nav class="foot-nav" aria-label="All pages">
        {[...groups, { name: 'About', items: ABOUT }].map((g) => (
          <div>
            <h2>{g.name}</h2>
            <ul>{g.items.map((i) => <li><a href={i.href}>{i.name}</a></li>)}</ul>
          </div>
        ))}
      </nav>
      <p class="foot-note">Clocks show their live sync state. Timers use your device's monotonic clock. City data: <a href="/about/data">GeoNames (CC BY 4.0)</a>.</p>
    </footer>
    <script>
      import '../widgets/theme-switch';
      import '../widgets/fullscreen';
      import '../widgets/menu';
      import '../widgets/search-launcher';
    </script>
  </body>
</html>
